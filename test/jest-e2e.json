{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@boot/(.*)$": "<rootDir>/../ddd-src/boot/$1",
    "^@career/(.*)$": "<rootDir>/../ddd-src/contexts/career/$1",
    "^test/(.*)$": "<rootDir>/$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/jest-setup.ts"]
}
